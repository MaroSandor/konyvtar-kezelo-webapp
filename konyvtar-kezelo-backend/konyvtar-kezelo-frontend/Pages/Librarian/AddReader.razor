@page "/Librarian/AddReader"
@using konyvtar_kezelo_frontend.Models
@inject HttpClient Http
@inject NavigationManager NavigationManager

<h3 class="mb-4">Add New Reader</h3>

<div class="row">
    <div class="col-md-6">
        <EditForm Model="newReader" OnValidSubmit="HandleValidSubmit">
            <DataAnnotationsValidator />
            
            <div class="mb-3">
                <label for="name" class="form-label">Name</label>
                <InputText id="name" class="form-control" @bind-Value="newReader.Name" />
                <ValidationMessage For="@(() => newReader.Name)" class="text-danger" />
            </div>

            <div class="mb-3">
                <label for="address" class="form-label">Address</label>
                <InputText id="address" class="form-control" @bind-Value="newReader.Address" />
                <ValidationMessage For="@(() => newReader.Address)" class="text-danger" />
            </div>

            <div class="mb-3">
                <label for="birthYear" class="form-label">Birth Year</label>
                <InputNumber id="birthYear" class="form-control" @bind-Value="newReader.BirthYear" />
                <ValidationMessage For="@(() => newReader.BirthYear)" class="text-danger" />
            </div>

            <button type="submit" class="btn btn-success">Save Reader</button>
            <button type="button" class="btn btn-secondary ms-2" @onclick="Cancel">Cancel</button>
        </EditForm>
    </div>
</div>

@code {
    private Reader newReader = new Reader();

    private async Task HandleValidSubmit()
    {
        try
        {
            await Http.PostAsJsonAsync("api/readers", newReader);
            NavigationManager.NavigateTo("/Librarian/Readers");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving data: {ex.Message}");
        }
    }

    private void Cancel()
    {
        NavigationManager.NavigateTo("/Librarian/Readers");
    }
}
