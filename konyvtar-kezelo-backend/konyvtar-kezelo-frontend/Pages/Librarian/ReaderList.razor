@page "/Librarian/Readers"
@using konyvtar_kezelo_frontend.Models
@inject HttpClient Http

<h3 class="mb-4">Manage Readers</h3>

@if (readers == null)
{
    <div class="d-flex align-items-center">
        <strong>Loading...</strong>
        <div class="spinner-border ms-auto" role="status" aria-hidden="true"></div>
    </div>
}
else
{
    <div class="mb-3">
        <a href="/Librarian/AddReader" class="btn btn-primary mb-3">Add New Reader</a>
    </div>

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Address</th>
                <th>Birth Year</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var reader in readers)
            {
                <tr>
                    <td>@reader.Id</td>
                    <td>@reader.Name</td>
                    <td>@reader.Address</td>
                    <td>@reader.BirthYear</td>
                    <td>
                        <a href="/Librarian/EditReader/@reader.Id" class="btn btn-sm btn-warning">Edit</a>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteReader(reader.Id)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Reader>? readers;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            readers = await Http.GetFromJsonAsync<List<Reader>>("api/readers");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching data: {ex.Message}");
        }
    }

    private async Task DeleteReader(int id)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/readers/{id}");
            
            if (response.IsSuccessStatusCode)
            {
                readers = await Http.GetFromJsonAsync<List<Reader>>("api/readers");
            }
            else
            {
                Console.WriteLine("Hiba történt a törlés során.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Kivétel történt: {ex.Message}");
        }
    }
}
