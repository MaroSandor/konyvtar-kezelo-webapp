@page "/Librarian/Borrowings"
@using konyvtar_kezelo_frontend.Models
@inject HttpClient Http

<h3 class="mb-4">Manage Borrowings</h3>

@if (borrowings == null)
{
    <div class="d-flex align-items-center">
        <strong>Loading...</strong>
        <div class="spinner-border ms-auto" role="status" aria-hidden="true"></div>
    </div>
}
else
{
    <div class="mb-3">
        <a href="/Librarian/AddBorrowing" class="btn btn-primary mb-3">Add New Borrowing</a>
    </div>

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Reader Name</th>
                <th>Book Title</th>
                <th>Borrow Date</th>
                <th>Deadline</th>
                <th>Late Fee</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var borrowing in borrowings)
            {
                <tr>
                    <td>@borrowing.Id</td>
                    <td>@GetReaderName(borrowing.ReaderId)</td>
                    <td>@GetBookTitle(borrowing.BookId)</td>
                    <td>@borrowing.BorrowDate.ToShortDateString()</td>
                    <td>@borrowing.DueDate.ToShortDateString()</td>
                    <td class="text-danger fw-bold">@borrowing.LateFee Ft</td>
                    <td>
                        <a href="/Librarian/EditBorrowing/@borrowing.Id" class="btn btn-sm btn-warning">Edit</a>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteBorrowing(borrowing.Id)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
@code {
    private List<Borrowing>? borrowings;
    private List<Reader> readers = new();
    private List<Book> books = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            borrowings = await Http.GetFromJsonAsync<List<Borrowing>>("api/borrowings");
            readers = await Http.GetFromJsonAsync<List<Reader>>("api/readers") ?? new List<Reader>();
            books = await Http.GetFromJsonAsync<List<Book>>("api/books") ?? new List<Book>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching data: {ex.Message}");
        }
    }

    private string GetReaderName(int id)
    {        
        var reader = readers.FirstOrDefault(r => r.Id == id);
        return reader != null ? reader.Name : "Ismeretlen olvasó";
    }

    private string GetBookTitle(int id)
    {
        var book = books.FirstOrDefault(b => b.Id == id);
        return book != null ? book.Title : "Ismeretlen könyv";
    }

    private async Task DeleteBorrowing(int id)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/borrowings/{id}");
            
            if (response.IsSuccessStatusCode)
            {
                borrowings = await Http.GetFromJsonAsync<List<Borrowing>>("api/borrowings");
            }
            else
            {
                Console.WriteLine("Hiba történt a törlés során.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Kivétel történt: {ex.Message}");
        }
    }
}
