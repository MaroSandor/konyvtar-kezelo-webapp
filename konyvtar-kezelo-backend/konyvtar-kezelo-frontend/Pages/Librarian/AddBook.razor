@page "/Librarian/AddBook"
@using konyvtar_kezelo_frontend.Models
@inject HttpClient Http
@inject NavigationManager NavigationManager

<h3 class="mb-4">Add New Book</h3>

<div class="row">
    <div class="col-md-6">
        <EditForm Model="newBook" OnValidSubmit="HandleValidSubmit">
            <DataAnnotationsValidator />
            
            <div class="mb-3">
                <label for="title" class="form-label">Title</label>
                <InputText id="title" class="form-control" @bind-Value="newBook.Title" />
                <ValidationMessage For="@(() => newBook.Title)" class="text-danger" />
            </div>

            <div class="mb-3">
                <label for="author" class="form-label">Author</label>
                <InputText id="author" class="form-control" @bind-Value="newBook.Author" />
                <ValidationMessage For="@(() => newBook.Author)" class="text-danger" />
            </div>

            <div class="mb-3">
                <label for="publisher" class="form-label">Publisher</label>
                <InputText id="publisher" class="form-control" @bind-Value="newBook.Publisher" />
                <ValidationMessage For="@(() => newBook.Publisher)" class="text-danger" />
            </div>

            <div class="mb-3">
                <label for="releaseYear" class="form-label">Release Year</label>
                <InputNumber id="releaseYear" class="form-control" @bind-Value="newBook.ReleaseYear" />
                <ValidationMessage For="@(() => newBook.ReleaseYear)" class="text-danger" />
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-success">Save Book</button>
                <button type="button" class="btn btn-secondary ms-2" @onclick="Cancel">Cancel</button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private Book newBook = new Book();

    private async Task HandleValidSubmit()
    {
        try
        {
            var response = await Http.PostAsJsonAsync("api/books", newBook);
            
            if (response.IsSuccessStatusCode)
            {
                NavigationManager.NavigateTo("/Librarian/Books");
            }
            else
            {
                Console.WriteLine("Error during saving.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    private void Cancel()
    {
        NavigationManager.NavigateTo("/Librarian/Books");
    }
}